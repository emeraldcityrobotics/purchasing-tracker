# Session
SESSION_SECRET=change-me-in-production

# CORS / redirect target after login
FRONTEND_ORIGIN=http://localhost:4200

# OIDC (required)
OIDC_ISSUER=https://your-idp.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
# Must exactly match the redirect URI registered with your IdP.
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback

# OIDC (optional, defaults shown)
OIDC_SCOPES=openid profile email groups
OIDC_GROUPS_CLAIM=groups
# JSON map of app role (admin | approver | purchaser) -> list of IdP group names/paths.
# Users not in any listed group are denied login.
OIDC_ROLE_MAP={"admin":["purchasing-admins"],"approver":["purchasing-approvers"],"purchaser":["purchasing-purchasers"]}
